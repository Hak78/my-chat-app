[app]
title = MyChatApp
package.name = mychatapp
package.domain = org.chat
source.dir = .
source.include_exts = py,png,jpg,kv,atlas
version = 0.1
requirements = python3,kivy
orientation = portrait
fullscreen = 0
android.permissions = INTERNET,CAMERA
android.api = 33
android.minapi = 21
android.sdk = 33
android.ndk = 25b
android.presplash_color = #2E3B4E

[buildozer]
log_level = 2
warn_on_root = 1
